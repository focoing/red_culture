# ===== 复制为 .env 并按需修改 =====

# ---- LLM（硅基流动 SiliconFlow，OpenAI 兼容接口） ----
# 在 https://cloud.siliconflow.cn 申请 API Key
# 变量名沿用 ZHIPU_* 历史命名；任何 OpenAI 兼容平台均可通过 ZHIPU_BASE_URL 切换
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
LLM_TEMPERATURE=0.3

# ---- Embedding（BAAI-BGE，本地权重） ----
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
# 国内镜像：https://hf-mirror.com
HF_ENDPOINT=https://hf-mirror.com

# ---- RAG ----
TOP_K=5
CHUNK_SIZE=450
CHUNK_OVERLAP=60

# ---- 混合检索与重排 ----
HYBRID_ENABLED=true           # 向量+BM25 双路召回，RRF 融合（纯向量检索设为 false）
BM25_CANDIDATES=10            # BM25 腿召回候选数
RRF_K=60                      # RRF 融合常数
RRF_WEIGHT_VECTOR=1.0         # 向量腿融合权重（主）
RRF_WEIGHT_BM25=0.5           # BM25 腿融合权重（辅）
MAX_PER_VENUE=2               # 单场馆最多召回块数（多样性约束，0 关闭）
RERANKER_ENABLED=false        # 二阶段重排（首次开启会经 HF_ENDPOINT 镜像下载模型，CPU 增加约 1-3 秒延迟）
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_CANDIDATES=12          # 参与重排的融合候选数

# ---- 应用 ----
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080   # 生产同源部署可留空即同源，无需跨域
MAX_HISTORY_ROUNDS=6

# ---- 账户体系 ----
# 登录令牌签名密钥：生产部署必须显式设置（任意长随机串，如 python -c "import secrets;print(secrets.token_hex(32))"）
# 未设置时使用进程级随机密钥：服务每次重启所有用户掉线（启动日志会警告）
AUTH_SECRET=
TOKEN_TTL_HOURS=168         # 登录令牌有效期（小时），默认 7 天
# 用户库默认 backend/data/users.db（USERS_DB 可覆盖）

# ---- 工程底座：会话持久化 / 语义缓存 / 限流 / LLM 稳定性 ----
# 会话与缓存默认存放在 backend/data/ 下的 SQLite（SESSION_DB / CACHE_DB 可覆盖）
CACHE_ENABLED=true          # 语义缓存总开关
CACHE_TTL_HOURS=24          # 缓存有效期（小时）
CACHE_SIM_THRESHOLD=0.92    # 命中所需余弦相似度阈值
RATE_LIMIT_PER_MIN=20       # 每用户/每 IP 每分钟 LLM 接口请求上限（计数存 SQLite，多 worker 共享）
LLM_TIMEOUT=180             # 单次 LLM 请求超时（秒）
LLM_MAX_RETRIES=5           # LLM 服务 429 限流时的指数退避重试次数
# LLM_THINKING=false        # GLM 系列深度思考开关（对 DeepSeek 等模型无效）：留空=模型默认；false 响应更快

# ---- 智能工具调用（LLM Function Calling） ----
TOOL_CALLING_ENABLED=true       # 参观信息类问题允许模型调用本地场馆查询工具（false 关闭，回退纯 RAG）
AGENT_MAX_STEPS=3               # Agentic 工具决策循环轮数上限（每轮最多 2 个工具；普通问题不进入循环）

# ---- 场馆导览 ----
SECTION_MIN_DOCS=2              # 点位内检索召回不足该数时放宽为整馆检索

# ---- 高德地图 Web 服务（可选：跨场馆真实公交/地铁换乘） ----
# 在 https://console.amap.com 申请「Web 服务」类型 Key；留空则换乘功能自动关闭
AMAP_KEY=
