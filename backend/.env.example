# ===== 复制为 .env 并按需修改 =====

# ---- LLM（Ollama） ----
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.3
LLM_NUM_CTX=8192

# ---- Embedding（BAAI-BGE，本地权重） ----
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
# 国内镜像：https://hf-mirror.com
HF_ENDPOINT=https://hf-mirror.com

# ---- RAG ----
TOP_K=5
CHUNK_SIZE=450
CHUNK_OVERLAP=60

# ---- 应用 ----
APP_PORT=8000
CORS_ORIGINS=*
MAX_HISTORY_ROUNDS=6

# ---- Docker 部署时，宿主机 Ollama 用 ----
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# 或 docker-compose 内网： http://ollama:11434
